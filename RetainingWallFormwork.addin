<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>ARBA Encofrado</Name>
    <Assembly>RetainingWallFormwork\RetainingWallFormwork.dll</Assembly>
    <FullClassName>RetainingWallFormwork.RibbonApp</FullClassName>
    <ClientId>5b8d2f41-7c3e-4a96-9d10-2e6f8a1c4b73</ClientId>
    <VendorId>LOCAL</VendorId>
