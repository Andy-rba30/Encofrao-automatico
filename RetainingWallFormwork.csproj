<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 corre sobre .NET 10. Para 2025/2026 seria net8.0-windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <!-- Permite compilar el proyecto -windows en Linux/CI sin instalar Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RetainingWallFormwork</AssemblyName>
    <RootNamespace>RetainingWallFormwork</RootNamespace>
    <!-- Revit ya carga sus propias DLL: no copiarlas al output -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Copia a la carpeta de add-ins de Revit al compilar: por defecto solo en Debug y en Windows -->
    <DeployToRevit Condition="'$(DeployToRevit)'=='' AND '$(Configuration)'=='Debug' AND '$(OS)'=='Windows_NT'">true</DeployToRevit>
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo ensamblados de referencia: Revit ya carga los suyos. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="RetainingWallFormwork.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Despliegue para desarrollo: %AppData%\Autodesk\Revit\Addins\2027\RetainingWallFormwork\ (por usuario).
    Se activa con -p:DeployToRevit=true (o automaticamente en Debug en Windows) y se
    desactiva con -p:DeployToRevit=false para no molestar en CI.
  -->
  <Target Name="CopyToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)'=='true'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
      <AddinDir>$(RevitAddinsDir)RetainingWallFormwork\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)config.json" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(AddinDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)RetainingWallFormwork.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Message Importance="high" Text="RetainingWallFormwork desplegado en $(AddinDir)" />
  </Target>

</Project>
